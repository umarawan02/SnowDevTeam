# ─── Anthropic (agent pipeline — used from Phase 1 onward) ───────────────────
ANTHROPIC_API_KEY=
# Model for all five pipeline agents. Verified valid 2026-08: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# ─── ServiceNow PDI (basic auth — admin, used by now-sdk + setup-oauth) ─────
# Full instance URL, e.g. https://dev123456.service-now.com
SN_INSTANCE_URL=
SN_USERNAME=
SN_PASSWORD=
# Credential alias the now-sdk stores these under (see `now-sdk auth --list`)
SN_AUTH_ALIAS=pdi

# ─── ServiceNow OAuth (native engine — per instance) ────────────────────────
# `pnpm --filter web setup-oauth <instanceId>` provisions the OAuth client and
# prints these. <REF> = the Instance row's `name`, uppercased (e.g. DEV424712).
# SNOW_CRED_<REF>_CLIENT_ID=
# SNOW_CRED_<REF>_CLIENT_SECRET=
# SNOW_CRED_<REF>_TOKEN_URL=   # optional; defaults to <instance>/oauth_token.do

# ─── Paths ─────────────────────────────────────────────────────────────────
# Root dir holding every customer's Fluent projects (workspaces/<customer>/<project>/).
WORKSPACES_ROOT=./workspaces
