# apps/web/.env — Prisma CLI + Next.js runtime env. Copy to `.env` and fill in.
# (Anthropic key / ServiceNow creds go in the repo-root .env instead.)

# PostgreSQL. Start it with `docker compose up -d` from the repo root
# (compose exposes Postgres on host port 5433).
DATABASE_URL="postgresql://snow:snow@localhost:5433/snowdevteam?schema=public"

# Signs session JWTs. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Seeded on `pnpm --filter web db:seed` as the first ADMIN user.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_NAME=
