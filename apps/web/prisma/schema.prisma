// Prisma schema for the AI ServiceNow delivery-team MVP.
// Docs: https://pris.ly/d/prisma-schema
//
// Status / role / artifact-type values are stored as plain strings.
// The allowed value sets live in src/lib/constants.ts (single source of truth,
// imported by the pipeline orchestration in Phase 1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application user. Auth is credentials (email + bcrypt hash) for now; `image`
// / null passwordHash leave room for OAuth later. Roles are plain strings —
// allowed values in src/lib/auth/rbac.ts.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         String    @default("REQUESTER") // ADMIN | REVIEWER | REQUESTER
  active       Boolean   @default(true)
  image        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdTickets  Ticket[] @relation("TicketCreatedBy")
  reviewedTickets Ticket[] @relation("TicketReviewedBy")
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  description String
  // PENDING | RUNNING | READY_FOR_REVIEW | DEPLOYING | FAILED | DEPLOYED | REJECTED
  status      String   @default("PENDING")
  // Required note captured when a reviewer rejects the ticket.
  reviewNote  String?
  // Optional intake metadata (captured by the intake wizard; all nullable).
  requester   String?
  priority    String? // LOW | MEDIUM | HIGH
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Audit: who submitted, and who approved/rejected at the review gate.
  createdById  String?
  createdBy    User?   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?   @relation("TicketReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  steps     AgentStep[]
  artifacts Artifact[]
}

model AgentStep {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // BA | ARCHITECT | SENIOR_DEV | DEVELOPER | QA
  role  String
  order Int
  // PENDING | RUNNING | COMPLETE | FAILED
  status String @default("PENDING")

  output String?
  error  String?

  // Run telemetry (populated by the pipeline; nullable for older rows).
  personaName String?
  model       String?
  costUsd     Float?
  numTurns    Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ticketId, order])
}

model Artifact {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // REQUIREMENTS | DESIGN | TASK_LIST | CODE | TEST_PLAN | QA_REPORT | DEPLOY_LOG | DEPLOY_VERIFICATION
  type    String
  content String

  createdAt DateTime @default(now())
}

// Editable AI-team member. One row per pipeline role, seeded from
// src/lib/agents/personas.ts on first read. The name + `voice` note are threaded
// into that agent's system prompt at run time.
model AgentPersona {
  id         String   @id @default(cuid())
  role       String   @unique // BA | ARCHITECT | SENIOR_DEV | DEVELOPER | QA
  name       String
  title      String
  tagline    String
  bio        String
  voice      String
  accent     String // hex, drives the generated avatar + accents
  avatarSeed String
  model      String? // optional per-agent model override
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
