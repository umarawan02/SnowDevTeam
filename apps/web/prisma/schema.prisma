// Prisma schema for the AI ServiceNow delivery-team MVP.
// Docs: https://pris.ly/d/prisma-schema
//
// Status / role / artifact-type values are stored as plain strings.
// The allowed value sets live in src/lib/constants.ts (single source of truth,
// imported by the pipeline orchestration in Phase 1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application user. Auth is credentials (email + bcrypt hash) for now; `image`
// / null passwordHash leave room for OAuth later. Roles are plain strings —
// allowed values in src/lib/auth/rbac.ts.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         String    @default("REQUESTER") // ADMIN | REVIEWER | REQUESTER
  active       Boolean   @default(true)
  image        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdTickets      Ticket[]             @relation("TicketCreatedBy")
  reviewedTickets     Ticket[]             @relation("TicketReviewedBy")
  intakeConversations IntakeConversation[]
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  description String
  // PENDING | RUNNING | READY_FOR_REVIEW | DEPLOYING | FAILED | DEPLOYED | REJECTED
  status      String   @default("PENDING")
  // Required note captured when a reviewer rejects the ticket.
  reviewNote  String?
  // Rework loop: how many times the pipeline has looped back for QA fixes, and
  // the directive driving the most recent rework (QA report excerpt or a
  // reviewer's note).
  reworkRound  Int     @default(0)
  reworkReason String?
  // Where the pipeline builds and deploys: "global" (default — plain
  // platform-wide records) or "scoped" (the x_1460392_delivery app).
  // Superseded by project.kind once tier.ts (Phase 3) picks projects
  // automatically; kept as the intake-time signal for now.
  targetScope String @default("global")

  // Multi-customer model (REFACTOR_BRIEF Phase 1). All nullable — rows
  // created before this phase have none of these set.
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  instanceId String?
  instance   Instance?      @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  projectId  String?
  project    FluentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // FLUENT_GLOBAL_APP | FLUENT_SCOPED_APP | FLUENT_MOVE_CUSTOMIZE |
  // REST_UPDATE_SET_FALLBACK | NOT_SUPPORTED — mirrors targetScope for now;
  // becomes a real decision in tier.ts (Phase 3).
  executionTier String?
  tierRationale String?
  gitBranch     String?
  prUrl         String?
  // null | DEV | TEST | PROD — the native engine's promotion state
  // (NATIVE_ENGINE_BRIEF Phase 5). Set by apply.ts (DEV) and promote.ts.
  releaseGate String?
  // Change-request number required before a PROD promote (brief §5.4).
  changeRequestRef String?

  // Optional intake metadata (captured by the intake wizard; all nullable).
  requester   String?
  priority    String? // LOW | MEDIUM | HIGH
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Audit: who submitted, and who approved/rejected at the review gate.
  createdById  String?
  createdBy    User?   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?   @relation("TicketReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  steps     AgentStep[]
  artifacts Artifact[]

  intakeConversation IntakeConversation?
  nativeDeployment   NativeDeployment?
}

// A conversational intake session: the requester talks to an assistant that
// gathers requirements, then hands off to the pipeline. Owned by one user.
model IntakeConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New request")
  status    String   @default("GATHERING") // GATHERING | BUILDING
  ticketId  String?  @unique
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages IntakeMessage[]
}

model IntakeMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   IntakeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  createdAt      DateTime           @default(now())
}

model AgentStep {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // BA | ARCHITECT | SENIOR_DEV | DEVELOPER | QA
  role  String
  order Int
  // PENDING | RUNNING | COMPLETE | FAILED
  status String @default("PENDING")

  output String?
  error  String?

  // Run telemetry (populated by the pipeline; nullable for older rows).
  personaName String?
  model       String?
  costUsd     Float?
  numTurns    Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ticketId, order])
}

model Artifact {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // See ARTIFACT_TYPE in src/lib/constants.ts for the full value set.
  type    String
  content String

  createdAt DateTime @default(now())
}

// --- NATIVE_ENGINE_BRIEF Phase 5: native-engine deployment record --------
// One row per ticket that went through the native (Table-API + update-set)
// engine rather than the Fluent tier. Holds the update set that IS the
// rollback unit, the applied change→sys_id map, and the dev→test→prod state.
model NativeDeployment {
  id       String @id @default(cuid())
  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  // Resolved scope the writes landed in ("global" | "x_acme_hr") and its sys_id.
  scope      String
  scopeSysId String

  updateSetSysId String
  updateSetName  String

  // APPLYING | APPLIED | APPLY_FAILED | PROMOTING | IN_TEST | IN_PROD | ROLLED_BACK
  state String @default("APPLYING")

  // [{ changeId, table, sysId, operation: "inserted" | "updated" }]
  appliedChanges Json @default("[]")

  // sn_cicd remote update set sys_ids captured during promotion.
  remoteUpdateSetTest String?
  remoteUpdateSetProd String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Editable AI-team member. One row per pipeline role, seeded from
// src/lib/agents/personas.ts on first read. The name + `voice` note are threaded
// into that agent's system prompt at run time.
model AgentPersona {
  id         String   @id @default(cuid())
  role       String   @unique // BA | ARCHITECT | SENIOR_DEV | DEVELOPER | QA
  name       String
  title      String
  tagline    String
  bio        String
  voice      String
  accent     String // hex, drives the generated avatar + accents
  avatarSeed String
  model      String? // optional per-agent model override
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// --- REFACTOR_BRIEF Phase 1: Customers, Instances, Projects ---------------
// Replaces the hard-coded scope pair (x_1460392_delivery / "AI Delivery
// Global") with a real data model: one Customer owns N Instances (ServiceNow
// environments) and N FluentProjects (Fluent apps, each pinned to one
// Instance). A Ticket is attributed to a customer/instance/project instead of
// deploying into a shared, vendor-owned workspace.

model Customer {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  instances Instance[]
  projects  FluentProject[]
  tickets   Ticket[]
}

model Instance {
  id   String @id @default(cuid())
  name String
  url  String
  // dev | test | prod
  env String @default("dev")

  // Populated by the release probe (Phase 3): family name (Yokohama, Zurich,
  // Australia, …) and raw build info from sys_properties.
  releaseName       String?
  releaseBuild      String?
  releaseDetectedAt DateTime?

  // oauth_cc | basic — Phase 4 replaces basic auth with per-instance OAuth
  // client-credentials. credentialRef is an opaque pointer into a secret
  // store (env-var-backed for now); never the secret itself.
  authMode              String  @default("basic")
  credentialRef         String
  readOnlyCredentialRef String?

  isDeployTarget Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  projects          FluentProject[]
  tickets           Ticket[]
  nativeDeployments NativeDeployment[]

  @@unique([customerId, name])
}

model FluentProject {
  id   String @id @default(cuid())
  name String

  // "global" or "x_…" / "sn_…"
  scope   String
  scopeId String
  // "global" | "scoped"
  kind String

  // Path to the project directory, relative to WORKSPACES_ROOT.
  repoPath      String
  gitRemote     String?
  defaultBranch String  @default("main")
  // "init" | "init_from" | "import" — how this project was created.
  createdVia String

  packageResolverVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  tickets Ticket[]

  @@unique([customerId, scopeId])
}
